  },
  "name": "Gronk",
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#85c46c"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#c9a26d"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ed94c0"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#83f1ff"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ed94c0"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage.type",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#6c95eb"
      }
    },
    {
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#6c95eb"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#a4a4a4"
      }
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#a4a4a4"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#39cc8f"
      }
    },
    {
      "scope": [
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "entity.name.function.macro",
        "support.function.macro",
        "keyword.control.import",
        "keyword.other.use"
      ],
      "settings": {
        "foreground": "#4eade5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "storage.type.class",
        "entity.name.type.class",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#c191ff"
      }
    },
    {
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#e2bfff"
      }
    },
    {
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.trait"
      ],
      "settings": {
        "foreground": "#9591ff"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "storage.modifier.namespace"
      ],
      "settings": {
        "foreground": "#ffb083"
      }
    },
    {
      "scope": [
        "support.module",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#ffc794"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#edeecf"
      }
    },
    {
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "support.variable.property",
        "entity.name.variable.field"
      ],
      "settings": {
        "foreground": "#91c2ff"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#ed94c0"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#6c95eb"
      }
    },
    {
      "scope": [
        "invalid.deprecated",
        "comment.unused"
      ],
      "settings": {
        "foreground": "#787878"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#edeecf"
      }
    }
  ],
  "type": "dark"
}
